{
  "name": "tinode-webapp",
  "description": "Tinode messenger for the web",
  "version": "0.25.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinode/webapp.git"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "echo 'Read installation instructions'",
    "build": "npm run vers && npm run build:css && npm run extract && npm run build:i18n && npm run build:prod && npm run build:dev",
    "clean": "rm umd/* && rm css/base.min.css && rm src/i18n.min/*",
    "build:css": "postcss css/base.css > css/base.min.css",
    "build:dev": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "build:i18n": "node scripts/i18n.js",
    "i18n:missing": "node scripts/i18n.js missing",
    "i18n:obsolete": "node scripts/i18n.js obsolete",
    "vers": "node scripts/gen-version.js",
    "extract": "formatjs extract \"src/**/*.{js,jsx}\" --out-file src/i18n/ex/base-en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile": "formatjs compile",
    "test": "jest"
  },
  "overrides": {
    "@babel/core": "$@babel/core",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "glob": "$glob",
    "test-exclude": {
      "minimatch": "^11.0.9"
    }
  },
  "browserslist": [
    "defaults"
  ],
  "files": [
    "umd/*.js",
    "umd/*.map",
    "audio/*.m4a",
    "css/base.css",
    "css/base.min.css",
    "img/*.png",
    "img/*.svg",
    "img/*.jpeg",
    "img/bkg/*.jpg",
    "img/bkg/*.png",
    "img/bkg/*.json",
    "index-dev.html",
    "index.html",
    "manifest.json",
    "service-worker.js",
    "version.js"
  ],
  "keywords": [
    "chat",
    "instant-messenger",
    "message",
    "messenger",
    "react",
    "web"
  ],
  "locales": [
    "ar",
    "de",
    "en",
    "es",
    "fr",
    "id",
    "it",
    "ko",
    "ro",
    "ru",
    "th",
    "uk",
    "vi",
    "zh",
    "zh-TW"
  ],
  "main": "umd/index.prod.js",
  "bugs": {
    "url": "https://github.com/tinode/webapp/issues"
  },
  "homepage": "https://github.com/tinode/chat",
  "email": "info@tinode.co",
  "author": "Tinode Authors <info@tinode.co>",
  "license": "Apache-2.0",
  "dependencies": {
    "firebase": "^13.4.0",
    "libphonenumber-js": "^1.13.17",
    "qrcodejs": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.2.0",
    "tinode-sdk": "^0.25.4",
    "webm-duration-fix": "^1.0.4"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@formatjs/cli": "^6.20.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-formatjs": "^13.0.11",
    "browserslist": "^4.29.6",
    "copy-webpack-plugin": "^14.0.0",
    "cssnano": "^9.9.0",
    "glob": "^14.0.6",
    "jest": "^30.5.2",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
